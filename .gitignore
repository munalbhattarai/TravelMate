# ==========================================
# TravelMate — Root Git Ignore
# ==========================================

# Python & Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Secrets
.env
*.env
.env.*
!.env.example
backend/.env
!backend/.env.example

# Database & Media
*.sqlite3
*.sqlite3-journal
media/
backend/media/
staticfiles/
backend/staticfiles/

# Operating System & IDE
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.bak
*.tmp
